{
  "name": "agenticenv-chat",
  "displayName": "AgenticEnv Chat",
  "description": "Chat panel inside VS Code for a local OpenHands agent (AgenticEnv), via the openhands-bridge WebSocket server.",
  "version": "0.4.0",
  "publisher": "hadrient",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HadrienT/agenticenv-chat.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Chat",
    "AI",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agenticenvChat",
          "title": "AgenticEnv Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agenticenvChat": [
        {
          "id": "agenticenvChat.view",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agenticenvChat.newSession",
        "title": "AgenticEnv Chat: New Session",
        "icon": "$(add)"
      },
      {
        "command": "agenticenvChat.reconnect",
        "title": "AgenticEnv Chat: Reconnect to Bridge",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agenticenvChat.newSession",
          "when": "view == agenticenvChat.view",
          "group": "navigation"
        },
        {
          "command": "agenticenvChat.reconnect",
          "when": "view == agenticenvChat.view",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "AgenticEnv Chat",
      "properties": {
        "agenticenvChat.bridgeUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:8300",
          "description": "WebSocket URL of the openhands-bridge server (packages/openhands-bridge in the AgenticEnv repo, started with `just run-bridge`)."
        },
        "agenticenvChat.agenticEnvPath": {
          "type": "string",
          "default": "~/AgenticEnv",
          "description": "Path to the AgenticEnv repository checkout on this machine. Used by the Components panel to read configs/openhands.yaml and to run start/stop commands."
        },
        "agenticenvChat.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Verbosity of the \"AgenticEnv Chat\" output channel. Use \"trace\" to see every bridge frame."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
